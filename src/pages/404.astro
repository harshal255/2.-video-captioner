---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Page Not Found | FrameCraft"
  description="The requested page could not be found."
>
  <div class="flex flex-col items-center justify-center text-center py-20 gap-4 font-sans">
    <span class="text-6xl font-extrabold font-mono text-amber-500">404</span>
    <h1 class="text-2xl font-bold text-zinc-100">Page Not Found</h1>
    <p class="text-xs text-zinc-400 max-w-md">
      Sorry, the page you are looking for does not exist or has been moved.
    </p>
    <a
      href="/"
      class="mt-2 py-2.5 px-6 rounded-xl font-bold uppercase tracking-wider text-xs bg-amber-500 hover:bg-amber-400 text-zinc-950 transition-all shadow-md"
    >
      Return to Video Frame Tool
    </a>
  </div>
</Layout>
