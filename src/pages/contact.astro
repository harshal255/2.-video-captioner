---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us — FrameCraft"
  description="Get in touch with the FrameCraft developer team directly via email."
>
  <div class="max-w-3xl mx-auto py-8 space-y-6 font-sans">
    <div class="border-b border-slate-200 dark:border-zinc-850 pb-4">
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-zinc-100 tracking-tight">Contact Us</h1>
      <p class="text-xs text-slate-600 dark:text-zinc-400 font-mono mt-1">Direct developer support & inquiries.</p>
    </div>

    <div class="p-8 rounded-2xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 flex flex-col items-center text-center gap-6 shadow-xl">
      <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-500 flex items-center justify-center text-2xl font-bold">
        ✉️
      </div>

      <div class="space-y-2">
        <h2 class="text-xl font-bold text-slate-900 dark:text-zinc-100">Have a question or feedback?</h2>
        <p class="text-xs text-slate-600 dark:text-zinc-400 max-w-md mx-auto">
          We welcome feature requests, business inquiries, or technical feedback regarding FrameCraft Video Frame Extractor.
        </p>
      </div>

      <div class="w-full max-w-md p-4 rounded-xl border border-slate-300 dark:border-zinc-800 bg-slate-50 dark:bg-zinc-950 flex items-center justify-between gap-3 shadow-inner">
        <div class="flex items-center gap-2.5 overflow-hidden">
          <span class="text-xs font-mono font-bold text-amber-600 dark:text-amber-500 truncate select-all">
            harshalskahar389@gmail.com
          </span>
        </div>

        <a
          href="mailto:harshalskahar389@gmail.com"
          class="py-2 px-4 rounded-lg text-xs font-bold uppercase tracking-wider bg-amber-500 hover:bg-amber-400 text-zinc-950 transition-all cursor-pointer shadow-md shrink-0 font-sans"
        >
          Send Email
        </a>
      </div>

      <p class="text-[11px] text-slate-500 dark:text-zinc-500 font-mono">
        Average response time: Within 24 hours.
      </p>
    </div>
  </div>
</Layout>
